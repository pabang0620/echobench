# EchoBench runs with no keys at all: PayPal is a local stand-in and the AI step is mocked.
# Everything below is optional. Copy to .env to use it. Never commit .env.

PORT=3101
PUBLIC_URL=http://127.0.0.1:3101
DATA_DIR=./data
ECHOBENCH_OPERATOR=you

# --- PayPal sandbox (leave empty to use the local stand-in) ---
# Sandbox credentials only. With credentials the server refuses to start unless this is a PayPal sandbox host.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# The id PayPal gave the webhook you registered for EchoBench's receiver URL
PAYPAL_WEBHOOK_ID=

# --- Which client talks to PayPal (the judge and MugShop) ---
# sdk = the APIMatic-generated PayPal SDK (default). rest = the same calls by plain fetch, to run a scenario through both.
PAYPAL_CLIENT_IMPL=sdk

# --- AI diagnosis. Empty = mocked model output (tools, tsc and re-runs are still real) ---
# LLM_BACKEND=account runs the AI step through your local Claude Code login (the API key is then never read). Local use only.
LLM_BACKEND=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Exposure ---
# Set this when EchoBench is reachable from the internet (tunnel). Then only POST /hooks/paypal is open;
# everything else needs the token (header x-echobench-token, or open the page once with ?token=...).
ECHOBENCH_ACCESS_TOKEN=

# --- Timing ---
SETTLE_WINDOW_MS=6000

# --- R1: unmodified EverShop (see targets/evershop/README.md) ---
EVERSHOP_DIR=
EVERSHOP_DB_NAME=evershop
EVERSHOP_DB_ADMIN_URL=
EVERSHOP_DB_READONLY_URL=
EVERSHOP_PORT=3000
EVERSHOP_WEBHOOK_PATH=/api/paypal/webhook
EVERSHOP_START_CMD=npm run start

# Force the stand-in and the mocked model even if keys are present
# 1 = a hosted demo starts every process from the planted MugShop
RESET_WORKSPACE_ON_START=0
FORCE_MOCK=0
