{
  "name": "echobench",
  "version": "1.0.0",
  "description": "PayPal webhook replay lab: records real deliveries, shakes them, judges your handler against PayPal's own records",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "seed": "node scripts/seed.js",
    "precompute": "node scripts/precompute.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "record-live": "node scripts/record-live.js",
    "verify-model": "node scripts/verify-model.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@anthropic-ai/sdk": "^1.8.0",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "paypal": "github:context-plugins/paypal-typescript-sdk#main",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
